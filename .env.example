# ============================================================
# Healthcare AI Platform — Environment Configuration
# ============================================================
# Copy this file to .env and fill in the values.
#   cp .env.example .env
# ============================================================

# ---- PostgreSQL ----
# Purpose: Database for all patient, appointment, and workflow data
# Required: Yes
# Default works for local Docker development
POSTGRES_USER=healthcare
POSTGRES_PASSWORD=healthcare_dev_2024
POSTGRES_DB=healthcare_platform
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql://healthcare:healthcare_dev_2024@postgres:5432/healthcare_platform

# ---- Groq LLM ----
# Purpose: AI model provider for triage, intake, follow-up agents
# Required: Yes
# Where to get it: https://console.groq.com → API Keys → Create API Key
GROQ_API_KEY=gsk_your_groq_api_key_here

# Groq model to use (llama-3.3-70b-versatile recommended)
GROQ_MODEL=llama-3.3-70b-versatile

# ---- n8n ----
# Purpose: Workflow orchestration engine
# Required: Yes (auto-configured in Docker)
N8N_BASIC_AUTH_ACTIVE=true
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=admin
N8N_HOST=n8n
N8N_PORT=5678
N8N_PROTOCOL=http
N8N_WEBHOOK_URL=http://localhost:5678
N8N_ENCRYPTION_KEY=change-this-to-a-random-string

# ---- Backend ----
# Purpose: Express REST API server
# Required: Yes (auto-configured in Docker)
BACKEND_PORT=3000
BACKEND_URL=http://backend:3000
NODE_ENV=development

# ---- Frontend ----
# Purpose: Static frontend served by Nginx
# Required: Yes (auto-configured in Docker)
FRONTEND_PORT=3001

# ---- Notification Config ----
# Purpose: Controls notification behavior
# Required: No (defaults to mock/DB-logged)
# Options: mock | smtp | resend
NOTIFICATION_PROVIDER=mock

# Only needed if NOTIFICATION_PROVIDER=smtp
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASS=your-app-password

# ---- Safety Engine ----
# Purpose: Emergency detection sensitivity
# Required: No (sensible defaults built in)
SAFETY_CONFIDENCE_THRESHOLD=0.7
SAFETY_RISK_SCORE_EMERGENCY=8
SAFETY_RISK_SCORE_URGENT=5
